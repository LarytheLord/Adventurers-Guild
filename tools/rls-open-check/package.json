{
  "name": "rls-open-check",
  "version": "0.1.0",
  "description": "Static linter for risky Row Level Security setups in Supabase/Postgres SQL migrations. Text, JSON and SARIF output.",
  "license": "MIT",
  "author": "Guild (guilds.work)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LarytheLord/Adventurers-Guild.git",
    "directory": "tools/rls-open-check"
  },
  "homepage": "https://github.com/LarytheLord/Adventurers-Guild/tree/main/tools/rls-open-check#readme",
  "bugs": {
    "url": "https://github.com/LarytheLord/Adventurers-Guild/issues"
  },
  "type": "module",
  "bin": {
    "rls-open-check": "dist/bin.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "supabase",
    "postgres",
    "rls",
    "row-level-security",
    "lint",
    "linter",
    "security",
    "sarif",
    "migrations"
  ],
  "dependencies": {
    "libpg-query": "^18.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
